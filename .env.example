# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real keys.

# --- Chat model -------------------------------------------------------------
# LLM_PROVIDER: gemini (default) | groq | openai | openai-compatible
# For Groq: set LLM_PROVIDER=groq and LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=gemini
# Gemini free-tier friendly: gemini-3.5-flash-lite (larger allowance),
# gemini-3.8-flash (higher quality). Use a model your project lists.
LLM_MODEL=gemini-3.5-flash-lite
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (free, chat only): https://console.groq.com/keys
GROQ_API_KEY=
# Optional explicit override used by any provider; leave empty to use the key above.
LLM_API_KEY=
# Only used for LLM_PROVIDER=openai-compatible, e.g. https://api.example.com/v1
LLM_BASE_URL=

# --- Embeddings -------------------------------------------------------------
# auto (Gemini when a key exists, otherwise local) | gemini | openai | local
# Groq has no embedding endpoint: pair Groq chat with gemini (GEMINI_API_KEY) or local.
EMBEDDING_PROVIDER=auto
# Blank = gemini-embedding-001 for Gemini, text-embedding-3-small for OpenAI.
EMBEDDING_MODEL=

# --- Observability (LangSmith) ----------------------------------------------
# Tracing switches on automatically when LANGSMITH_API_KEY is set.
# Set LANGSMITH_TRACING=false to keep the key configured but stop uploading.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-academic-advisor
# Only for self-hosted LangSmith:
LANGSMITH_ENDPOINT=

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
CHROMA_DB_PATH=./chroma_db

# --- Chunking and retrieval -------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=4
